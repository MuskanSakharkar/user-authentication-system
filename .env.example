# MONGODB_URI: Connection string for MongoDB Atlas (e.g. mongodb+srv://user:pass@cluster.mongodb.net/auth_system)
MONGODB_URI=

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here

# PORT: Server port (3000)
PORT=3000

# GEMINI_API_KEY: Injected by environment if needed
GEMINI_API_KEY=
APP_URL=
